{
  "manifest_version": 3,
  "name": "Depop Seller helper",
  "version": "1.1",
  "description": "Adds an item's photos from the local Depop Seller page to Depop's 'List an item' form. Runs in your own Chrome; never posts.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
      "js": ["sell_page.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.depop.com/*", "https://depop.com/*"],
      "js": ["depop.js"],
      "run_at": "document_idle"
    }
  ]
}
